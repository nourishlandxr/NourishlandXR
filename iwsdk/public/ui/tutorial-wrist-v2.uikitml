<style>
  .wrist { width: 1000; height: 1000; flex-direction: column; }
  .control { position-type: absolute; width: 100; height: 100; border-radius: 22; border-width: 3; border-color: #aad8d8; background-color: #28484c; color: #f4fbfa; }
