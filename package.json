{
  "name": "nourishland-xr",
  "private": true,
  "version": "0.9101.0",
  "type": "module",
  "scripts": {
    "start": "node tools/persistence-server.mjs",
    "build": "node tools/build-hosted.mjs",
    "build:frontend": "node tools/build-hosted.mjs --frontend-only",
    "build:website": "npm run build:frontend && node root-site/tools/assemble-website.mjs --build",
    "build:iwsdk-preview": "npm --prefix iwsdk run build && node tools/build-hosted.mjs --frontend-only --with-iwsdk",
    "test": "node --test tests/*.test.mjs"
  },
  "devDependencies": {
    "acorn": "^8.19.0"
  }
}
